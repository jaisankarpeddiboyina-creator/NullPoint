# ── NullPoint Environment ──────────────────────────────────────
# Get your free Groq key at https://console.groq.com

GROQ_API_KEY=your_groq_api_key_here

# Optional: switch providers anytime — one line
# AI_PROVIDER=groq        ← default, free, fast
# AI_PROVIDER=openai
# AI_MODEL=llama-3.3-70b-versatile   ← default

# Auth — set to false for local dev
NULLPOINT_AUTH=false

# Your NullPoint API keys (comma separated)
# Leave empty to auto-generate one on startup
NULLPOINT_API_KEYS=

# Server port
PORT=3001
