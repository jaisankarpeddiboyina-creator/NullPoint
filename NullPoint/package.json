{
  "name": "nullpoint",
  "version": "1.0.0",
  "description": "Everything else is noise.",
  "private": true,
  "main": "dist/api/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "ts-node src/api/server.ts",
    "prestart": "npm run build",
    "start": "node dist/api/server.js",
    "cli": "ts-node src/cli/index.ts",
    "diagnostics:groq": "ts-node scripts/diagnostics/test-groq.ts",
    "diagnostics:ailink": "ts-node scripts/diagnostics/test-ailink.ts",
    "diagnostics:ailink-tools": "ts-node scripts/diagnostics/test-ailink-tools.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@ailink/sdk": "^0.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  }
}
